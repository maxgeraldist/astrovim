{
  "hover.target": "float",
  "signature.target": "float",
  "suggest.floatEnable": true,
  "suggest.detailMaxLength": 100,
  "suggest.maxPreviewWidth": 100,
  "languageserver": {
    "basedpyright": {
      "command": "basedpyright-langserver",
      "args": ["--stdio"],
      "filetypes": ["python"],
      "settings": {
        "basedpyright": {
          "analysis": {
            "typeCheckingMode": "off"
          }
        }
      }
    },
    "python": {
      "enable": false
    },
    "lua": {
      "command": "lua-language-server",
      "filetypes": ["lua"],
      "rootPatterns": [".git", "lua"]
    }
  }
}

